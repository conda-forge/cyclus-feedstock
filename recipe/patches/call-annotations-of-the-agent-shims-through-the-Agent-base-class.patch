From 2f3c175e0a98ba4b839be77d9191db96285d9da5 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Thu, 8 Oct 2026 14:35:50 -0600
Subject: [PATCH] fix: Call annotations() of the agent shims through the Agent
 base class

The annotations properties of the Region, Institution, and Facility
wrappers call annotations() through a pointer to the shim class. Cython
3.1 and newer reject this as an "ambiguous overloaded method", as they
do not treat the annotations() that the shim declares as an override of
the one it inherits from cyclus::Agent.

The call is now made through a cyclus::Agent pointer. As annotations()
is virtual this still calls the shim's implementation.

This does change how an error in the call is noticed. The shim declares
annotations() as "except *" and cyclus::Agent declares it as "except +",
so Cython now translates a C++ exception from the call in place of
checking for a Python exception after it. A Python exception raised by
the shim is still reported, as CPython raises a SystemError from it when
the property returns.

This is the last of the changes needed for the Cython sources to compile
with Cython 3.1 and newer. They still compile with Cython 0.29 and 3.0.

Refs: https://github.com/cyclus/cyclus Issue 1848
Assisted-by: ClaudeCode:claude-opus-5-5
---
 cyclus/agents.pyx | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/cyclus/agents.pyx b/cyclus/agents.pyx
index 95b32401..8823286e 100644
--- a/cyclus/agents.pyx
+++ b/cyclus/agents.pyx
@@ -1123,7 +1123,9 @@ cdef class _Region(_Agent):
         """Agent annotations."""
         cdef jsoncpp.Value cpp_rtn = jsoncpp.Value()
         if self._annotations is None:
-            cpp_rtn._inst[0] = (<CyclusRegionShim*> (<_Agent> self).shim).annotations()
+            # Call the virtual annotations() through the Agent base class, as
+            # Cython 3.1+ rejects the call on the shim type as ambiguous.
+            cpp_rtn._inst[0] = (<cpp_cyclus.Agent*> (<CyclusRegionShim*> (<_Agent> self).shim)).annotations()
         self._annotations = cpp_rtn
         return self._annotations
 
@@ -1323,7 +1325,9 @@ cdef class _Institution(_Agent):
         """Agent annotations."""
         cdef jsoncpp.Value cpp_rtn = jsoncpp.Value()
         if self._annotations is None:
-            cpp_rtn._inst[0] = (<CyclusInstitutionShim*> (<_Agent> self).shim).annotations()
+            # Call the virtual annotations() through the Agent base class, as
+            # Cython 3.1+ rejects the call on the shim type as ambiguous.
+            cpp_rtn._inst[0] = (<cpp_cyclus.Agent*> (<CyclusInstitutionShim*> (<_Agent> self).shim)).annotations()
         self._annotations = cpp_rtn
         return self._annotations
 
@@ -1524,7 +1528,9 @@ cdef class _Facility(_Agent):
         """Agent annotations."""
         cdef jsoncpp.Value cpp_rtn = jsoncpp.Value()
         if self._annotations is None:
-            cpp_rtn._inst[0] = (<CyclusFacilityShim*> (<_Agent> self).shim).annotations()
+            # Call the virtual annotations() through the Agent base class, as
+            # Cython 3.1+ rejects the call on the shim type as ambiguous.
+            cpp_rtn._inst[0] = (<cpp_cyclus.Agent*> (<CyclusFacilityShim*> (<_Agent> self).shim)).annotations()
         self._annotations = cpp_rtn
         return self._annotations
 
