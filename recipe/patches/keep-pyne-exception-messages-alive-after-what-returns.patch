     GroupNotFound(std::string fname, std::string gname)
     {
       filename = fname;
+      setMsg();
     };
 
-    /// helpful error message that includes the filename and the groupname
-    virtual const char* what() const throw()
+    /// Builds the message returned by what().
+    void setMsg()
     {
-      std::string msg ("the group ");
+      msg = "the group ";
       msg += groupname;
       msg += " not found in the file ";
       msg += filename;
-      return (const char *) msg.c_str();
+    };
+
+    /// helpful error message that includes the filename and the groupname
+    virtual const char* what() const throw()
+    {
+      return msg.c_str();
     };
 
   private:
+    std::string msg; ///< message returned by what()
     std::string filename;   ///< the HDF5 file
     std::string groupname;  ///< the group in the hierarchy
   };
@@ -436,7 +455,7 @@ namespace h5wrap
   public:
 
     /// default constructor
-    PathNotFound(){};
+    PathNotFound(){ setMsg(); };
 
     /// default destructor
     ~PathNotFound() throw () {};
@@ -446,19 +465,26 @@ namespace h5wrap
     {
       filename = fname;
       path = pname;
+      setMsg();
     };
 
-    /// helpful error message that includes the filename and the pathname
-    virtual const char* what() const throw()
+    /// Builds the message returned by what().
+    void setMsg()
     {
-      std::string msg ("the path ");
+      msg = "the path ";
       msg += path;
       msg += " was not found in the HDF5 file ";
       msg += filename;
-      return (const char *) msg.c_str();
+    };
+
+    /// helpful error message that includes the filename and the pathname
+    virtual const char* what() const throw()
+    {
+      return msg.c_str();
     };
 
   private:
+    std::string msg; ///< message returned by what()
     std::string filename; ///< the HDF5 file
     std::string path;     ///< the path in the file
   };
@@ -870,7 +896,7 @@ namespace nucname
   {
   public:
     /// default constructor
-    NotANuclide () {};
