     {
-      std::string FNH5str ("Not a valid HDF5 file: ");
+      FNH5str = "Not a valid HDF5 file: ";
       if (!filename.empty())
         FNH5str += filename;
+    };
 
-      return (const char *) FNH5str.c_str();
+    /// helpful error message that includes the filename
+    virtual const char* what() const throw()
+    {
+      return FNH5str.c_str();
     };
 
   private:
+    std::string FNH5str; ///< message returned by what()
     std::string filename; ///< the file which is not in HDF5 format.
   };
 
@@ -404,7 +416,7 @@ namespace h5wrap
   public:
 
     /// default constructor
-    GroupNotFound(){};
+    GroupNotFound(){ setMsg(); };
 
