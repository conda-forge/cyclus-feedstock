From e77848ce860fb0fe8f6706eb21f09946fde42293 Mon Sep 17 00:00:00 2001
From: Ben Nibbelink <79653949+bennibbelink@users.noreply.github.com>
Date: Wed, 28 Aug 2024 17:04:06 -0400
Subject: [PATCH] construct uuid correctly

---
 tests/query_backend_tests.cc | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/tests/query_backend_tests.cc b/tests/query_backend_tests.cc
index 15e956dfc0..d99205a173 100644
--- a/tests/query_backend_tests.cc
+++ b/tests/query_backend_tests.cc
@@ -102,10 +102,10 @@ TEST(QueryBackendTest, CmpCondUuid) {
   using cyclus::Cond;
   using cyclus::CmpCond;
   using boost::uuids::uuid;
-  uuid x = {0x12, 0x34, 0x56, 0x78, 0x90, 0xab, 0xcd, 0xef, 0x12, 0x34, 0x56,
-            0x78, 0x90, 0xab, 0xcd, 0xef};
-  uuid y = {0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42,
-            0x42, 0x42, 0x42, 0x42, 0x42};
+  uuid x ({0x12, 0x34, 0x56, 0x78, 0x90, 0xab, 0xcd, 0xef, 0x12, 0x34, 0x56,
+            0x78, 0x90, 0xab, 0xcd, 0xef});
+  uuid y ({0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42, 0x42,
+            0x42, 0x42, 0x42, 0x42, 0x42});
   uuid z = x;
   Cond cond = Cond("x", "==", z);
   EXPECT_PRED2(CmpCond<uuid>, &x, &cond);
